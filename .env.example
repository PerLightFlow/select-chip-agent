DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=chipagent
POSTGRES_USER=chipagent
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=0
DEBUG=0
# OpenAI-compatible protocol; base URL includes /v1 when required by provider.
# Do not put API keys into frontend variables or commit .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional provider-specific thinking switch: empty, enabled, disabled.
LLM_THINKING=
LLM_TEMPERATURE=0
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=1
EMBEDDING_DIMENSIONS=1024
# Calibrate this cosine-distance cutoff on the domain evaluation set.
EMBEDDING_MAX_DISTANCE=0.5
# Explicit operational fallback; normally keep 0 for production semantic indexing.
ALLOW_KEYWORD_ONLY=0

# Enable official-domain URL ingestion and background discovery; never auto-publishes.
OFFICIAL_ONLINE_ENABLED=1
AGENT_RUNTIME=chat
AGENT_WORKERS=50
AGENT_SEARCH_URL=http://search:8080
AGENT_SEARCH_ENGINES=google cse
AGENT_MAX_STEPS=16
AGENT_TURN_SECONDS=300
AGENT_MODEL_TIMEOUT=120
SEARXNG_SECRET=replace-with-a-separate-random-secret
