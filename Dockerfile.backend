FROM node:22-slim AS codex
RUN npm install --prefix /opt/codex @openai/codex@0.163.0 && find /opt/codex -type f -path '*/bin/codex' -exec cp '{}' /codex \;

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ /app/
COPY --from=codex /codex /usr/local/bin/codex
COPY licenses/codex/ /usr/share/licenses/codex/
RUN useradd --create-home app && mkdir -p /app/media /app/staticfiles && chown -R app:app /app
USER app
EXPOSE 8000
